# Copy this file to .env (repo root) and fill in the values you need. .env is
# git-ignored, so it's safe to put real values in it; only this .example file is
# checked in. scripts/launch.sh, launch.bat, and launch.ps1 all load .env automatically
# on every run -- a variable already set in your shell before invoking the launcher wins
# over the value here.

# Set to 1 to make the launch scripts also run the full equity-research-report pipeline
# (Stages 1-6 -- see BLUEPRINT.md's "Equity Research Report pipeline" section) and
# produce a PDF alongside the Excel model on every run, instead of passing REPORT=1
# inline each time. This makes several `claude -p` calls (subscription-billed through
# your existing Claude Code subscription, not a separately metered API) and takes
# noticeably longer than the Excel-only path -- expect several minutes, not seconds.
REPORT=1

# Optional overrides for the equity-report pipeline's price/consensus research stage.
# Only needed if the target institution's config.py doesn't already set TICKER/EXCHANGE,
# or you want to research a different ticker/exchange pair than the config's default.
# TICKER=
# EXCHANGE=
